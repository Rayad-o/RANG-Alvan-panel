# کپی کنید به .env و مقادیر را تغییر دهید
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
# برای توسعه با SQLite (نیازی به PostgreSQL نیست):
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# کلید امنیتی JWT - حتماً در محیط واقعی یک رشته تصادفی بلند تنظیم کنید
# می‌توانید با python -c "import secrets; print(secrets.token_urlsafe(48))" تولید کنید
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# مبدأهای مجاز CORS (با کاما جدا کنید)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# لاگ SQL (true/false)
SQL_ECHO=false